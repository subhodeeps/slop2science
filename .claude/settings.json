{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(scripts/run *)",
      "Bash(scripts/py *)",
      "Bash(scripts/run_stages.sh *)",
      "Bash(scripts/run_tests.sh *)",
      "Bash(scripts/check_env.sh)",
      "Bash(scripts/check_env.sh *)",
      "Bash(scripts/test_hooks.sh)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(scripts/library.py *)",
      "Bash(scripts/py scripts/library.py *)",
      "Bash(make libraries)",
      "Bash(make fetch-source *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git add *)",
      "Edit(/.claude/guard_paths.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)"
    ]
  },
  "env": {
    "JULIA_PROJECT": "@.",
    "JULIA_NUM_THREADS": "auto",
    "SYMBOLIC_TIMEOUT": "1800",
    "RESEARCH_RECORDS_DIR": "$HOME/.claude-research-records"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/py \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_paths.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_context.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/py \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_prompt.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precompact_checkpoint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/py \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/capture_session.py"
          }
        ]
      }
    ]
  }
}
